# LLM provider: gemini | claude | groq | mistral
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-preview-05-20

# Optional: Claude (if using LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=your_anthropic_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# Apps to monitor — full App Store URLs (comma-separated)
APPS_TO_MONITOR=https://apps.apple.com/us/app/wealthfront-save-and-invest/id816020992,https://apps.apple.com/us/app/public-invest-trade/id1204112719,https://apps.apple.com/us/app/wealthy-stocks-mutual-funds/id1222950243

# Scraping & refresh settings
MAX_REVIEWS_PER_APP=100
MAX_AGE_HOURS=24

# Dashboard
DASHBOARD_PORT=5000
DATA_FILE=data/app_data.json
